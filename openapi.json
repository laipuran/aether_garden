  "components": {
    "schemas": {
      "ContentKind": {
        "enum": [
          "blog",
          "note"
        ]
      },
      "ContentLoadFailure": {
        "required": [
          "filePath",
          "error"
        ],
        "type": "object",
        "properties": {
          "filePath": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "ContentReloadResult": {
        "required": [
          "reloadedAt",
          "blogCount",
          "notesCount",
          "failedFiles"
        ],
        "type": "object",
        "properties": {
          "reloadedAt": {
            "type": "string",
            "format": "date-time"
          },
          "blogCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "notesCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "failedFiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentLoadFailure"
            }
          }
        }
      },
      "GithubOverview": {
        "required": [
          "username",
          "profileUrl",
          "publicRepos",
          "followers",
          "following",
          "picked",
          "source"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "profileUrl": {
            "type": "string"
          },
          "publicRepos": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "followers": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "following": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "picked": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GithubRepo"
            }
          },
          "source": {
            "type": "string"
          }
        }
      },
      "GithubRepo": {
        "required": [
          "name",
          "description",
          "url",
          "language",
          "stars",
          "contributions",
          "isOwned"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "stars": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "contributions": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "isOwned": {
            "type": "boolean"
          }
        }
      },
      "MusicTrack": {
        "required": [
          "name",
          "artist",
          "artworkUrl",
          "appleMusicUrl",
          "neteaseUrl"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
